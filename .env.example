# Copy to .env.local for local testing. In production, set these in
# Netlify > Site configuration > Environment variables. NEVER commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server only.

# --- Launch email list (Brevo, double opt-in) — see docs/NEWSLETTER.md ---
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# Turns the sign-up form on for the build where it's set. In Netlify, set it
# for "Deploy Previews" first to test; add "Production" only after approval.
NEWSLETTER_ENABLED=
# NEWSLETTER_CONFIRMED_URL=https://funksquish.com/newsletter/confirmed

# --- Analytics (Umami Cloud, cookieless) — see docs/ANALYTICS-SEO.md ---
# Public by design: it only identifies the website in Umami.
# Analytics only loads on the Netlify PRODUCTION build (never locally or on previews).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Google Search Console (optional HTML-tag verification) ---
GOOGLE_SITE_VERIFICATION=

# --- Hosted checkout (Shopify Storefront API) — NOT ACTIVE, see docs/ECOMMERCE-ROADMAP.md ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_CHECKOUT_HOST=

# --- Stripe Checkout (B4 approved, TEST MODE ONLY) — see docs/STRIPE-TEST-SETUP.md ---
# Works ONLY on localhost (`npm run dev`) or Netlify Deploy Previews; refused on
# production and branch deploys. Live keys (sk_live_/rk_live_) are rejected.
# In Netlify set these for "Deploy Previews" ONLY — never "Production".
STRIPE_TEST_CHECKOUT_ENABLED=
STRIPE_TEST_SECRET_KEY=
# One or more test shipping rates (shr_...), comma-separated:
STRIPE_TEST_SHIPPING_RATE_IDS=
STRIPE_TEST_WEBHOOK_SECRET=
# Optional: set to true only after Stripe Tax is set up in TEST mode.
# STRIPE_TEST_AUTOMATIC_TAX=
# Optional: defaults to the preview URL (DEPLOY_PRIME_URL) or http://localhost:3000.
# STRIPE_TEST_RETURN_ORIGIN=http://localhost:3000
