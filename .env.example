# Copy to .env.local for local testing. In production, set these in
# Netlify > Site configuration > Environment variables. NEVER commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server only.

# --- Launch email list (Brevo, double opt-in) — see docs/NEWSLETTER.md ---
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# Turns the sign-up form on for the build where it's set. In Netlify, set it
# for "Deploy Previews" first to test; add "Production" only after approval.
NEWSLETTER_ENABLED=
# NEWSLETTER_CONFIRMED_URL=https://funksquish.com/newsletter/confirmed

# --- Drop & restock alerts (Brevo, double opt-in, SEPARATE list) — see docs/NEWSLETTER.md ---
# Reuses BREVO_API_KEY. Never point these at the launch list.
BREVO_DROPS_LIST_ID=
BREVO_DROPS_DOI_TEMPLATE_ID=
# Turns the alert form on for the build where it's set (Deploy Previews first).
DROP_ALERTS_ENABLED=
# DROP_ALERTS_CONFIRMED_URL=https://funksquish.com/drops/confirmed

# --- Partner / distributor applications — see docs/PARTNERS.md ---
# The form stays closed (email fallback) unless ALL of these are set.
# Generate the first two with `npm run partners:setup` in your own terminal.
PARTNER_REVIEW_PASSPHRASE_HASH=
PARTNER_SECRET=
PARTNER_NOTIFY_EMAIL=
PARTNER_NOTIFY_FROM=
PARTNER_APPLICATIONS_ENABLED=
# Local `next dev` testing only (in-memory, not durable). Never set on Netlify.
# PARTNER_DEV_MEMORY_STORE=true

# --- Analytics (Umami Cloud, cookieless) — see docs/ANALYTICS-SEO.md ---
# Public by design: it only identifies the website in Umami.
# Analytics only loads on the Netlify PRODUCTION build (never locally or on previews).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Google Search Console (optional HTML-tag verification) ---
GOOGLE_SITE_VERIFICATION=

# --- Hosted checkout (Shopify Storefront API) — NOT ACTIVE, see docs/ECOMMERCE-ROADMAP.md ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_CHECKOUT_HOST=

# --- Stripe Checkout (B4 approved, TEST MODE ONLY) — see docs/STRIPE-TEST-SETUP.md ---
# Works ONLY on localhost (`npm run dev`) or Netlify Deploy Previews; refused on
# production and branch deploys. Live keys (sk_live_/rk_live_) are rejected.
# In Netlify set these for "Deploy Previews" ONLY — never "Production".
STRIPE_TEST_CHECKOUT_ENABLED=
STRIPE_TEST_SECRET_KEY=
# One or more test shipping rates (shr_...), comma-separated:
STRIPE_TEST_SHIPPING_RATE_IDS=
STRIPE_TEST_WEBHOOK_SECRET=
# Optional: set to true only after Stripe Tax is set up in TEST mode.
# STRIPE_TEST_AUTOMATIC_TAX=
# Optional: defaults to the preview URL (DEPLOY_PRIME_URL) or http://localhost:3000.
# STRIPE_TEST_RETURN_ORIGIN=http://localhost:3000

# Stripe LIVE (production only; see docs/STRIPE-PRODUCTION.md). Locked until the code switch in
# src/lib/features.ts is flipped by a reviewed launch PR. Set these in Netlify (Production, secret) — never here.
# STRIPE_LIVE_CHECKOUT_ENABLED=
# STRIPE_LIVE_SECRET_KEY=          # rk_live_… restricted: Checkout Sessions write + Refunds write
# STRIPE_LIVE_WEBHOOK_SECRET=      # whsec_… from https://funksquish.com/api/stripe/webhook
# STRIPE_LIVE_SHIPPING_RATE_IDS=   # shr_…,shr_…
# STRIPE_LIVE_AUTOMATIC_TAX=

# Order emails (Brevo transactional). Default to PARTNER_NOTIFY_FROM / PARTNER_NOTIFY_EMAIL.
# ORDER_EMAIL_FROM=
# ORDER_NOTIFY_EMAIL=
# Send real order emails in TEST mode too (off by default so test orders never email anyone)
# STRIPE_TEST_SEND_EMAILS=
